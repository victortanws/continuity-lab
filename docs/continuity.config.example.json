{
  "schemaVersion": 2,
  "projectScopes": [
    {
      "id": "game",
      "label": "The game",
      "root": ".",
      "kind": "product",
      "exclude": ["examples/**"]
    },
    {
      "id": "tutorial-example",
      "label": "Tutorial example",
      "root": ".",
      "kind": "example",
      "include": ["examples/tutorial/**"]
    }
  ],
  "sourceRoutes": [
    {
      "pattern": "docs/PROTOTYPE-CONTRACT.md",
      "authority": "canon"
    },
    {
      "pattern": "docs/decisions/**",
      "authority": "canon"
    },
    {
      "pattern": "docs/archive/**",
      "authority": "proposal"
    },
    {
      "pattern": "data/**",
      "authority": "production"
    },
    {
      "pattern": "js/**",
      "authority": "production"
    },
    {
      "pattern": "tests/**",
      "authority": "production"
    }
  ]
}
